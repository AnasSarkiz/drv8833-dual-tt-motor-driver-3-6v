diff --git a/tests/components/pcb/pcb-position-metadata-schema.test.tsx b/tests/components/pcb/pcb-position-metadata-schema.test.tsx
new file mode 100644
index 0000000..1413244
--- /dev/null
+++ b/tests/components/pcb/pcb-position-metadata-schema.test.tsx
@@ -0,0 +1,57 @@
+import { expect, test } from "bun:test"
+import { pcb_component, pcb_group } from "circuit-json"
+import { getTestFixture } from "tests/fixtures/get-test-fixture"
+
+test("explicit PCB positions emit schema-valid display offsets", async () => {
+  const { circuit } = getTestFixture()
+  circuit.add(
+    <board width={24} height={16} routingDisabled>
+      <group name="G1" pcbX={-3} pcbY="0mm" pcbAnchorAlignment="center">
+        <resistor
+          name="R1"
+          resistance="1k"
+          footprint="0603"
+          pcbX={0}
+          pcbY={-2}
+        />
+      </group>
+      <resistor name="R2" resistance="1k" footprint="0603" pcbX="5mm" />
+      <resistor
+        name="R3"
+        resistance="1k"
+        footprint="0603"
+        pcbLeftEdgeX="calc(board.minX + 2mm)"
+        pcbY={5}
+      />
+      <pcbnotetext
+        text="Numeric, string and edge positions"
+        pcbY={-6}
+        fontSize={0.7}
+      />
+    </board>,
+  )
+  await circuit.renderUntilSettled()
+  for (const pcbComponent of circuit.db.pcb_component.list()) {
+    expect(() => pcb_component.parse(pcbComponent)).not.toThrow()
+  }
+  for (const pcbGroup of circuit.db.pcb_group.list()) {
+    expect(() => pcb_group.parse(pcbGroup)).not.toThrow()
+  }
+  const sourceR1 = circuit.db.source_component.getWhere({ name: "R1" })!
+  const pcbR1 = circuit.db.pcb_component.getWhere({
+    source_component_id: sourceR1.source_component_id,
+  })!
+  expect(pcbR1.display_offset_x).toBe("0")
+  expect(pcbR1.display_offset_y).toBe("-2")
+  expect(pcbR1.center).toEqual({ x: -3, y: -2 })
+  const sourceR2 = circuit.db.source_component.getWhere({ name: "R2" })!
+  const pcbR2 = circuit.db.pcb_component.getWhere({
+    source_component_id: sourceR2.source_component_id,
+  })!
+  expect(pcbR2.display_offset_x).toBe("5")
+  expect(pcbR2.display_offset_y).toBeUndefined()
+  await expect(circuit).toMatchPcbSnapshot(import.meta.path, {
+    showAnchorOffsets: true,
+    showPcbGroups: true,
+  })
+})
