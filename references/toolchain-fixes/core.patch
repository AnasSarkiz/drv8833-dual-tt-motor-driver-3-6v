+import { expect, test } from "bun:test"
+import { any_circuit_element } from "circuit-json"
+import { getTestFixture } from "../../fixtures/get-test-fixture"
+
+test("board and component silkscreen emit valid optional ownership", () => {
+  const { circuit } = getTestFixture()
+  circuit.add(
+    <board width={20} height={20} routingDisabled>
+      <silkscreentext text="BOARD ARTWORK" pcbY={7} />
+      <silkscreencircle radius={1} pcbX={-7} />
+      <silkscreenrect width={2} height={1} pcbX={7} />
+      <silkscreenline strokeWidth={0.15} x1={-2} y1={-7} x2={2} y2={-7} />
+      <silkscreenpath route={[{x:-2,y:-5},{x:2,y:-5}]} />
+      <resistor name="R1" resistance="1k" footprint="0603" />
+    </board>
+  )
+  circuit.render()
+  const artwork = circuit.getCircuitJson().filter((element) => element.type.startsWith("pcb_silkscreen_"))
+  expect(artwork.length).toBeGreaterThanOrEqual(5)
+  for (const element of artwork) expect(any_circuit_element.safeParse(element).success).toBe(true)
+  expect(circuit.db.pcb_silkscreen_text.list().find((text) => text.text === "BOARD ARTWORK")?.pcb_component_id).toBeUndefined()
+  expect(circuit.db.pcb_silkscreen_path.list().some((path) => path.pcb_component_id === circuit.db.pcb_component.list()[0].pcb_component_id)).toBe(true)
+  expect(circuit).toMatchPcbSnapshot(import.meta.path)
+})
