+import { expect, test } from "bun:test"
+import { getTestFixture } from "tests/fixtures/get-test-fixture"
+
+test("through-hole pads on a mixed-technology board have no automatic stencil paste", async () => {
+  const { circuit } = getTestFixture()
+  circuit.add(
+    <board width={18} height={12} routingDisabled>
+      <platedhole shape="circle" holeDiameter={1} outerDiameter={2} pcbX={-5} />
+      <platedhole shape="oval" holeWidth={1} holeHeight={1.5} outerWidth={2} outerHeight={3} pcbX={-1.5} />
+      <platedhole shape="pill" holeWidth={1} holeHeight={1.5} outerWidth={2} outerHeight={3} pcbX={2} />
+      <platedhole shape="circular_hole_with_rect_pad" holeDiameter={1} rectPadWidth={2} rectPadHeight={2} pcbX={5.5} />
+      <resistor name="R1" resistance="1k" footprint="0603" pcbY={-3} />
+      <pcbnotetext text="Four THT pads: no paste; R1: two top apertures" pcbY={4} fontSize={0.45} />
+    </board>,
+  )
+  await circuit.renderUntilSettled()
+  expect(circuit.db.pcb_plated_hole.list()).toHaveLength(4)
+  const stencilApertures = circuit.db.pcb_solder_paste.list()
+  expect(stencilApertures).toHaveLength(2)
+  expect(stencilApertures.every((aperture) => aperture.layer === "top" && "pcb_smtpad_id" in aperture)).toBe(true)
+  await expect(circuit).toMatchPcbSnapshot(import.meta.path)
+})
