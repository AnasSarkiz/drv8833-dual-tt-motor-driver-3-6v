+import { expect, test } from "bun:test"
+import { pcb_plated_hole } from "circuit-json"
+import { getTestFixture } from "tests/fixtures/get-test-fixture"
+
+test("pill holes with rectangular pads receive unique IDs and follow placement", async () => {
+  const { circuit } = getTestFixture()
+  circuit.add(
+    <board width={16} height={12} routingDisabled>
+      <chip
+        name="J1"
+        pcbX={3}
+        pcbY={2}
+        pinLabels={{ pin1: "A", pin2: "B" }}
+        footprint={
+          <footprint>
+            <platedhole
+              shape="pill"
+              rectPad
+              outerWidth={2}
+              outerHeight={2}
+              holeWidth={0.9}
+              holeHeight={1.2}
+              pcbX={-2}
+              portHints={["pin1"]}
+            />
+            <platedhole
+              shape="pill"
+              rectPad
+              outerWidth={2}
+              outerHeight={2}
+              holeWidth={0.9}
+              holeHeight={1.2}
+              pcbX={2}
+              portHints={["pin2"]}
+            />
+          </footprint>
+        }
+      />
+      <pcbnotetext
+        text="Two individually positioned plated slots"
+        pcbY={-4}
+        fontSize={0.55}
+      />
+    </board>,
+  )
+  await circuit.renderUntilSettled()
+  const platedHoles = circuit.db.pcb_plated_hole.list()
+  expect(platedHoles).toHaveLength(2)
+  expect(new Set(platedHoles.map((hole) => hole.pcb_plated_hole_id)).size).toBe(
+    2,
+  )
+  for (const hole of platedHoles) {
+    expect(() => pcb_plated_hole.parse(hole)).not.toThrow()
+    const pcbPort = circuit.db.pcb_port.get(hole.pcb_port_id!)!
+    expect(hole.x).toBeCloseTo(pcbPort.x)
+    expect(hole.y).toBeCloseTo(pcbPort.y)
+    expect(hole.y).toBe(2)
+  }
+  expect(platedHoles.map((hole) => hole.x).sort()).toEqual([1, 5])
+  await expect(circuit).toMatchPcbSnapshot(import.meta.path)
+})
