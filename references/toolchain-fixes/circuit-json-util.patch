diff --git a/tests/analyze-pcb-pin1-location.test.ts b/tests/analyze-pcb-pin1-location.test.ts
index 246bf91..ba0d82c 100644
--- a/tests/analyze-pcb-pin1-location.test.ts
+++ b/tests/analyze-pcb-pin1-location.test.ts
@@ -147,3 +147,23 @@ test("does not guess a two-pad frame without distinct axis-aligned pins 1 and 2"
     expect(analyzePcbPin1Location(pads)).toBeNull()
   }
 })
+
+// Actual imported LED pad centers, including inch-to-mm rounding.
+test("retains two-terminal polarity across sub-micron imported offsets", () => {
+  const importedPads = [
+    createPad(1, -0.7489952, -0.000127),
+    createPad(2, 0.7489952, 0.000127),
+  ]
+  for (const supplierRotation of rightAngles) {
+    for (const localRotation of rightAngles) {
+      const supplier = analyzePcbPin1Location(rotatePads(importedPads, supplierRotation))
+      const local = analyzePcbPin1Location(rotatePads(importedPads, localRotation))
+      expect(supplier).not.toBeNull()
+      expect(local).not.toBeNull()
+      expect(getRotationBetweenPcbPin1Locations(supplier!, local!)).toBe(
+        ((localRotation - supplierRotation + 360) % 360) as RightAngleRotation,
+      )
+    }
+  }
+  expect(analyzePcbPin1Location([createPad(1, -0.75, 0), createPad(2, 0.75, 0.005)])).toBeNull()
+})
diff --git a/tests/transform-outline-keepout.test.ts b/tests/transform-outline-keepout.test.ts
new file mode 100644
index 0000000..6ee67ca
--- /dev/null
+++ b/tests/transform-outline-keepout.test.ts
@@ -0,0 +1,14 @@
+import { expect, test } from "bun:test"
+import { pcb_keepout } from "circuit-json"
+import { compose, rotateDEG, translate } from "transformation-matrix"
+import { transformPCBElement } from "../lib/transform-soup-elements"
+
+test("outline keepouts transform their vertices without a synthetic center", () => {
+  const keepout = pcb_keepout.parse({ type: "pcb_keepout", pcb_keepout_id: "keepout_0", shape: "outline", outline: [{x: 0, y: 0}, {x: 2, y: 0}, {x: 2, y: 1}], stroke_width: 0.1, layers: ["top"] })
+  transformPCBElement(keepout, compose(translate(3, 4), rotateDEG(90)))
+  if (keepout.shape !== "outline") throw new Error("Expected outline keepout")
+  expect(keepout.outline[0]).toEqual({ x: 3, y: 4 })
+  expect(keepout.outline[1]).toEqual({ x: 3, y: 6 })
+  expect(keepout.outline[2]).toEqual({ x: 2, y: 6 })
+  expect("center" in keepout).toBe(false)
+})
