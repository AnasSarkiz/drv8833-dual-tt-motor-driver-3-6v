diff --git a/tests/pcb_silkscreen_owner.test.ts b/tests/pcb_silkscreen_owner.test.ts
new file mode 100644
index 0000000..3bce22b
--- /dev/null
+++ b/tests/pcb_silkscreen_owner.test.ts
@@ -0,0 +1,23 @@
+import { expect, test } from "bun:test"
+import { any_circuit_element } from "../src/any_circuit_element"
+
+const artwork = [
+  { type: "pcb_silkscreen_text", text: "Board revision A" },
+  { type: "pcb_silkscreen_circle", center: { x: 0, y: 0 }, radius: 1 },
+  { type: "pcb_silkscreen_rect", center: { x: 0, y: 0 }, width: 2, height: 1 },
+  { type: "pcb_silkscreen_path", route: [{ x: 0, y: 0 }, { x: 1, y: 1 }] },
+  { type: "pcb_silkscreen_line", x1: 0, y1: 0, x2: 1, y2: 1 },
+  { type: "pcb_silkscreen_oval", center: { x: 0, y: 0 }, radius_x: 2, radius_y: 1 },
+  { type: "pcb_silkscreen_pill", center: { x: 0, y: 0 }, width: 2, height: 1 },
+  { type: "pcb_silkscreen_graphic", shape: "brep", brep_shape: { outer_ring: { vertices: [{x:0,y:0},{x:1,y:0},{x:0,y:1}] } } },
+]
+
+test("board and group artwork does not require a component owner", () => {
+  for (const shape of artwork) {
+    const boardArtwork = { ...shape, layer: "top", stroke_width: 0.15, pcb_group_id: "pcb_group_board", subcircuit_id: "subcircuit_board" }
+    expect(any_circuit_element.safeParse(boardArtwork).success, shape.type).toBe(true)
+    expect(any_circuit_element.safeParse({ ...boardArtwork, pcb_component_id: "pcb_component_1" }).success).toBe(true)
+    expect(any_circuit_element.safeParse({ ...boardArtwork, pcb_component_id: null }).success).toBe(false)
+    expect(any_circuit_element.safeParse({ ...boardArtwork, pcb_component_id: 1 }).success).toBe(false)
+  }
+})
